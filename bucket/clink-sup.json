    "hash": "89cb2deccad968e5569eb039baca51a27add52d90e71a37d4f60de19265380d5",
    "post_install": "(Get-Content -Path \"$dir\\clink.bat\") | ForEach-Object { $_ -replace 'start \"Clink\" ', '' } | Set-Content -Path \"$dir\\clink_terminal.bat\"",
    "bin": "clink.bat",
    "checkver": {
        "github": "https://api.github.com/repos/chrisant996/clink/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "/v(?<tag>[\\d.]+)/clink\\.([\\d.]+)\\.(?<commit>[0-9a-f]+)\\.zip"
    },
    "persist": "profile",
    "autoupdate": {
        "url": "https://github.com/chrisant996/clink/releases/download/v$matchTag/clink.$version.$matchCommit.zip"
    }
