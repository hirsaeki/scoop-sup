    "pre_install": [
        "$launchers = @(Get-ChildItem -LiteralPath $dir -Recurse -Filter 'xdm-app.exe' -File)",
        "if ($launchers.Count -ne 1) { throw 'Expected exactly one XDM launcher in the extracted MSI' }",
        "if ($launchers[0].DirectoryName -ne $dir) { Get-ChildItem -LiteralPath $launchers[0].DirectoryName -Force | Move-Item -Destination $dir -ErrorAction Stop }"
    ],
    "bin": [
        [
            "xdm-app.exe",
            "xdm"
        ]
    ],
    "shortcuts": [
        [
            "xdm-app.exe",
            "Xtreme Download Manager"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/subhra74/xdm/releases/latest",
        "regex": "^(?<tag>v?([\\d.]+))$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/subhra74/xdm/releases/download/$matchTag/xdm-$version-x64.msi"
