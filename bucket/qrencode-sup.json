    "pre_install": [
        "$mingwRoot = switch ($ProcessorArchitecture) {",
        "    '64bit' { 'mingw64' }",
        "    '32bit' { 'mingw32' }",
        "    default { throw \"Unsupported QRencode architecture: $ProcessorArchitecture\" }",
        "}",
        "movedir (Join-Path $dir $mingwRoot) $dir | Out-Null",
        "$keep_files = @(\"$dir\\bin\\qrencode.exe\",",
        "                \"$dir\\bin\\libqrencode.dll\",",
        "                \"$dir\\bin\\libwinpthread-1.dll\",",
        "                \"$dir\\bin\\libpng16-16.dll\",",
        "                \"$dir\\bin\\zlib1.dll\",",
        "                \"$dir\\share\\licenses\\qrencode\\COPYING\",",
        "                \"$dir\\share\\man\\man1\\qrencode.1.gz\")",
        "",
        "if ($mingwRoot -eq 'mingw32') {",
        "    $keep_files += @(\"$dir\\bin\\libgcc_s_dw2-1.dll\",",
        "                     \"$dir\\share\\licenses\\libgcc\\COPYING.RUNTIME\",",
        "                     \"$dir\\share\\licenses\\libgcc\\COPYING3\")",
        "}",
        "Get-ChildItem \"$dir\" -Recurse                 |",
        "    Select-Object -ExpandProperty FullName      |",
        "    Where-Object {$keep_files -notcontains $_ } |",
        "    Sort-Object Length -Descending              |",
        "    ForEach-Object { if ((Test-Path $_ -Type Container) -and (Get-ChildItem $_)) { return } Remove-Item $_ }"
    ],
    "bin": "bin\\qrencode.exe"
}
